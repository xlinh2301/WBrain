{
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/inference.js": {
      "includeFiles": "monolith/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/v1/recognize", "destination": "/api/inference.js" },
    { "source": "/api/:path*", "destination": "/api/proxy.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
